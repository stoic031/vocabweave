{
	"name": "vocabweave",
	"version": "1.0.0",
	"description": "Turn vocabulary notes into Anki flashcards, with optional AI-generated text and images.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"type-check": "tsc --noEmit",
		"test:unit": "vitest run",
		"format:write": "prettier --write ."
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.1",
		"esbuild": "0.28.2",
		"eslint": "^10.10.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.12.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.13.1",
		"prettier": "^3.9.9",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.70.0",
		"vitest": "^5.0.1"
	}
}
